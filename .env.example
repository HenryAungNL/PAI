# ---------------------------------------------------------------------------
# PAI Docker Compose overrides. Copy to `.env` (next to docker-compose.yml) and
# adjust as needed. Every value has a working default, so `.env` is optional.
# NEVER commit a populated .env file.
# ---------------------------------------------------------------------------

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Cookies — set COOKIE_SECURE=True when serving over HTTPS.
COOKIE_SECURE=False
COOKIE_SAMESITE=Lax

# Where the SPA is reachable (used for Stripe redirects and email links).
SITE_URL=http://localhost:8080

# Stripe (optional). Leave blank to run without payments.
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Branding / contact
PLATFORM_NAME=PAI
SUPPORT_EMAIL=support@pai.example.com
