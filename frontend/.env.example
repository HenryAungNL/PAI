# ---------------------------------------------------------------------------
# PAI frontend environment (Vite). Copy to `.env.local` for local development.
# Variables must be prefixed with VITE_ to be exposed to the browser.
# ---------------------------------------------------------------------------

# Base URL the SPA calls for the REST API. A relative path keeps requests on the
# same origin: the dev server proxies them, and nginx does the same in Docker.
VITE_API_BASE_URL=/api/v1

# Where the Vite dev server forwards /api, /media and /health (used by
# vite.config.ts). Change if the backend runs elsewhere.
VITE_PROXY_TARGET=http://localhost:8000
