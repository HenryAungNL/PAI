# ---------------------------------------------------------------------------
# PAI backend environment. Copy to `.env` and fill in real values.
# NEVER commit a populated .env file.
# ---------------------------------------------------------------------------

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8080
# Absolute path where the SQLite database and media are persisted.
PAI_DATA_DIR=/app/data

# Cookies — set COOKIE_SECURE=True and COOKIE_SAMESITE=Lax (or Strict) behind HTTPS.
COOKIE_SECURE=False
COOKIE_SAMESITE=Lax

# CORS — the origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Stripe (test-mode keys by default). Leave blank to disable payments UI.
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Where the SPA lives (used for Stripe redirect URLs and password-reset links).
SITE_URL=http://localhost:5173
PLATFORM_NAME=PAI
SUPPORT_EMAIL=support@pai.example.com
DEFAULT_CURRENCY=usd

# Uploads
MAX_UPLOAD_SIZE_MB=10

# Email (console backend prints messages to the container logs in development).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@pai.example.com

# Production hardening (only applied when DJANGO_DEBUG=False)
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000
LOG_LEVEL=INFO
